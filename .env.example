NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clerk. Both keys must be set in every environment that serves /sign-in,
# /sign-up or /admin — proxy.ts returns 503 on those paths when either is
# missing or empty, so the rest of the site stays up while auth is down.
#
# pk_test_/sk_test_ belong to a Clerk DEVELOPMENT instance: fine locally, but
# not for a live domain. Production needs a Clerk PRODUCTION instance, which
# requires adding the site's domain in the Clerk dashboard and creating the
# DNS records it issues; that instance then provides pk_live_/sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional. Defaults are fine; set them only to move the auth routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase projects may use this instead of the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATE_SECRET=
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Used only during production builds to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Amazon Associates. The partner tag alone is enough for working affiliate
# links. Access/secret keys additionally enable the Product Advertising API for
# live title, image, price and availability — PA-API also requires an approved
# Associates account with 3 qualifying sales in the last 180 days.
AMAZON_PARTNER_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Defaults suit the US marketplace; change all three together for other locales.
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com
